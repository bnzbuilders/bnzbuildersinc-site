---
import { u, abs, unbase } from '../lib/paths';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business, services, PREVIEW_NOINDEX, SHOW_OFFICE_STREET } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Include GeneralContractor JSON-LD. */
  localBusinessSchema?: boolean;
  /** Per-page noindex (e.g. 404). PREVIEW_NOINDEX applies to every page regardless. */
  noindex?: boolean;
}
const { title, description, localBusinessSchema = false, noindex = false } = Astro.props;
// Canonical always points at the launch domain (https://bnzbuilders.com), without the preview base.
const canonical = abs(unbase(Astro.url.pathname));
const ogImage = abs('/og.png');
const siteUrl = abs('/');
const robots = PREVIEW_NOINDEX ? 'noindex, nofollow' : noindex ? 'noindex' : null;

// Only verified, public facts. No licenses, certifications, ratings or bonding.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${siteUrl}#business`,
  name: business.legalName,
  url: siteUrl,
  logo: abs('/favicon.svg'),
  image: ogImage,
  description: business.summary,
  telephone: business.phoneE164,
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    ...(SHOW_OFFICE_STREET ? { streetAddress: business.address.street, postalCode: business.address.postalCode } : {}),
    addressLocality: business.address.city,
    addressRegion: business.address.region,
    addressCountry: business.address.country,
  },
  areaServed: [
    { '@type': 'State', name: 'New York' },
    { '@type': 'City', name: 'New York City' },
    { '@type': 'Place', name: 'Long Island, NY' },
  ],
  knowsAbout: services.map((s) => s.title),
};
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    <meta name="theme-color" content="#18302a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${business.legalName} — ${business.tagline}`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="format-detection" content="telephone=no" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    {localBusinessSchema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Subtle reveal-on-scroll. Skipped entirely when reduced motion is requested.
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
