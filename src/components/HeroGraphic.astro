---
/** Decorative blueprint-style elevation drawing (non-photographic).
 *  Generic building + crane linework. Not a depiction of any BNZ project. */
const floors = 6, floorH = 62, groundY = 600, left = 110, bays = 5, bayW = 84;
const right = left + bays * bayW; // 530
const topY = groundY - floors * floorH; // 228
const windows: { x: number; y: number; w: number; h: number }[] = [];
for (let f = 1; f < floors; f++) {
  for (let b = 0; b < bays; b++) {
    for (let k = 0; k < 2; k++) windows.push({ x: left + b * bayW + 12 + k * 34, y: groundY - (f + 1) * floorH + 14, w: 26, h: 36 });
  }
}
const scafX = [right - 2 * bayW, right - 2 * bayW + 56, right - 2 * bayW + 112, right + 4];
const ledgers: number[] = [];
for (let y = groundY - 40; y > topY - 30; y -= 40) ledgers.push(y);
const gridX = Array.from({ length: bays + 1 }, (_, i) => left + i * bayW);
const letters = 'ABCDEF';
---
<svg class="hero-graphic" viewBox="0 0 720 660" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustration: blueprint-style line drawing of a building elevation with scaffolding and a tower crane">
  <g class="hg-lines" fill="none" stroke="currentColor" stroke-width="1.2">
    <!-- grid bubbles + grid lines -->
    {gridX.map((x, i) => (
      <g>
        <path d={`M${x} 150V${groundY + 20}`} stroke-dasharray="2 6" stroke-opacity=".35" />
        <circle cx={x} cy="132" r="13" />
        <text x={x} y="137" text-anchor="middle" font-size="13" font-family="Inter Variable, Inter, Arial, sans-serif" fill="currentColor" stroke="none">{letters[i]}</text>
      </g>
    ))}
    <!-- building -->
    <path class="hg-draw" d={`M${left} ${groundY}V${topY}H${right}V${groundY}`} stroke-width="2.4" />
    <path d={`M${left - 6} ${topY}H${right + 6}M${left - 6} ${topY - 10}H${right + 6}V${topY}M${left - 6} ${topY - 10}V${topY}`} stroke-width="1.6" />
    {Array.from({ length: floors - 1 }, (_, i) => <path d={`M${left} ${groundY - (i + 1) * floorH}H${right}`} stroke-opacity=".5" />)}
    {windows.map((w) => <rect x={w.x} y={w.y} width={w.w} height={w.h} stroke-opacity=".75" />)}
    <!-- storefront -->
    {Array.from({ length: bays }, (_, b) => (
      <g stroke-opacity=".8">
        <rect x={left + b * bayW + 8} y={groundY - floorH + 10} width={bayW - 16} height={floorH - 10} />
        <path d={`M${left + b * bayW + bayW / 2} ${groundY - floorH + 10}V${groundY}`} />
      </g>
    ))}
    <!-- scaffold -->
    <g class="hg-scaffold" stroke-opacity=".9">
      {scafX.map((x) => <path d={`M${x + 18} ${groundY}V${topY - 30}`} />)}
      {ledgers.map((y) => <path d={`M${scafX[0] + 18} ${y}H${scafX[3] + 18}`} />)}
      {ledgers.slice(0, -1).map((y, i) => <path d={i % 2 ? `M${scafX[0] + 18} ${y}L${scafX[1] + 18} ${y - 40}` : `M${scafX[2] + 18} ${y}L${scafX[3] + 18} ${y - 40}`} stroke-opacity=".5" />)}
    </g>
    <!-- ground + dimension -->
    <path d={`M30 ${groundY}H700`} stroke-width="2" />
    <path d={`M30 ${groundY + 6}H700`} stroke-opacity=".3" stroke-dasharray="1 5" />
    <path d={`M${left} ${groundY + 34}H${right}M${left} ${groundY + 26}v16M${right} ${groundY + 26}v16`} stroke-opacity=".6" />
    <path d={`M${left - 40} ${groundY}V${topY}M${left - 48} ${groundY}h16M${left - 48} ${topY}h16`} stroke-opacity=".6" />
    {Array.from({ length: floors }, (_, i) => <path d={`M${left - 44} ${groundY - i * floorH}h8`} stroke-opacity=".6" />)}
  </g>
  <!-- tower crane (accent) -->
  <g class="hg-crane" fill="none" stroke="var(--tan)" stroke-width="1.6">
    <path class="hg-draw" d="M626 600V70M646 600V70" />
    {Array.from({ length: 13 }, (_, i) => <path d={`M626 ${600 - i * 40}L646 ${560 - i * 40}`} stroke-opacity=".6" />)}
    <path class="hg-draw" d="M300 70H700M300 88H690M626 70L636 30L646 70M636 30L300 70M636 30L700 70" />
    {Array.from({ length: 16 }, (_, i) => <path d={`M${308 + i * 24} 88L${320 + i * 24} 70`} stroke-opacity=".5" />)}
    <rect x="672" y="88" width="26" height="22" />
    <path class="hg-hook" d="M392 88V262M380 262h24v14h-24zM392 276v8a6 6 0 1 1-6 6" />
  </g>
  <!-- highlighted bay -->
  <rect x={left + bayW} y={groundY - 4 * floorH} width={bayW} height={floorH} fill="var(--tan)" fill-opacity=".14" stroke="var(--tan)" stroke-width="1.4" stroke-dasharray="6 4" />
  <!-- title block -->
  <g font-family="Inter Variable, Inter, Arial, sans-serif" fill="currentColor">
    <path d="M30 636H420" stroke="currentColor" stroke-opacity=".3" />
    <text x="30" y="654" font-size="11" font-weight="700" letter-spacing="2.4" fill-opacity=".8">ILLUSTRATIVE ELEVATION · NOT A BNZ PROJECT DRAWING</text>
  </g>
</svg>
