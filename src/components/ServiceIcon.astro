  building: 'M4 21V7l8-4 8 4v14M4 21h16M9 21v-4h6v4M8 9h2M14 9h2M8 13h2M14 13h2',
  bath: 'M3 12h18v2a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5zM6 12V5a2 2 0 0 1 4 0M7 19l-1 2M17 19l1 2',
  drywall: 'M3 4h18v16H3zM3 10h18M3 15h18M9 4v6M15 10v5M9 15v5',
  tile: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
  hammer: 'M13 4l7 7-2 2-7-7zM11.5 8.5L3 17l3 3 8.5-8.5M14 3l2 2',
  capitol: 'M3 21h18M5 21v-9M9 21v-9M15 21v-9M19 21v-9M3 12h18L12 4zM12 2v2',
