---
import { u } from '../lib/paths';
import { business, home } from '../data/site';
interface Props { heading?: string; text?: string }
const { heading = home.ctaHeading, text = home.ctaText } = Astro.props;
---
<section class="cta-band" aria-labelledby="cta-h">
  <div class="wrap">
    <div>
      <h2 id="cta-h">{heading}</h2>
    </div>
    <div>
      <p>{text}</p>
      <div class="btn-row" style="margin-top:24px">
        <a class="btn btn--dark" href={u('/contact/')}>Request a Quote <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href={business.phoneHref}>Call {business.phoneDisplay}</a>
      </div>
    </div>
  </div>
</section>
