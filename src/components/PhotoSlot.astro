---
import { u } from '../lib/paths';
/** Clearly labelled placeholder for an APPROVED project photo. Never swap in
 *  stock or AI images that could be mistaken for BNZ work. Pass `src` only
 *  once a real, approved photo exists. */
interface Props { src?: string; alt?: string; label?: string; ratio?: string; tone?: 'light' | 'dark'; small?: boolean }
const { src, alt = '', label = 'Approved project photo coming soon', ratio = '4 / 3', tone = 'light', small = false } = Astro.props;
---
{src
  ? <img class="photo" src={u(src)} alt={alt} loading="lazy" style={`aspect-ratio:${ratio}`} />
  : (
    <div class:list={['photo-slot', `photo-slot--${tone}`, { 'photo-slot--small': small }]} style={`aspect-ratio:${ratio}`} role="img" aria-label={`Placeholder: ${label}`}>
      <span class="photo-slot-label">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="6" width="18" height="14" rx="1.5" /><path d="M8 6l1.5-2h5L16 6" /><circle cx="12" cy="13" r="3.5" /></svg>
        <span>{label}</span>
      </span>
    </div>
  )}
