---
import { u } from '../lib/paths';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import CtaBand from '../components/CtaBand.astro';
import { seo, services } from '../data/site';
---
<Base title={seo.services.title} description={seo.services.description}>
  <PageHero
    eyebrow="Our services"
    title="Commercial construction, start to finish."
    lead="Painting is our core trade. Around it, we deliver commercial renovations, bathrooms, drywall and ceilings, flooring and tile, general construction and public works across New York."
  >
    <nav class="jump" aria-label="Services on this page">
      <ul>{services.map((s) => <li><a href={`#${s.slug}`}>{s.title}</a></li>)}</ul>
    </nav>
  </PageHero>

  <div class="svc-sections">
    {services.map((s, i) => (
      <section id={s.slug} class:list={['svc-section', { 'svc-section--core': s.core, 'svc-section--alt': i % 2 === 1 }]} aria-labelledby={`${s.slug}-h`}>
        <div class="wrap svc-section-grid">
          <div class="svc-section-visual reveal" aria-hidden="true">
            <div class="svc-visual">
              <span class="svc-visual-num">{String(i + 1).padStart(2, '0')}</span>
              <ServiceIcon name={s.icon} size={88} />
            </div>
          </div>
          <div class="svc-section-copy reveal">
            {s.core && <span class="tag">Core trade</span>}
            <h2 id={`${s.slug}-h`}>{s.title}</h2>
            <p class="lead">{s.intro}</p>
            <ul class="tick-list tick-list--cols">
              {s.items.map((item) => <li>{item}</li>)}
            </ul>
            <div class="btn-row">
              <a class="btn btn--dark" href={u('/contact/')}>Request a Quote <span class="arrow" aria-hidden="true">→</span></a>
              {s.slug === 'government-contracting' && <a class="btn btn--outline-dark" href={u('/government-contracting/')}>Government contracting</a>}
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <CtaBand heading="Need a painting or renovation quote?" />
</Base>
