---
import { u } from '../lib/paths';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import StatusBadge from '../components/StatusBadge.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import CtaBand from '../components/CtaBand.astro';
import { seo, publicProjects, projectLocation } from '../data/site';
---
<Base title={seo.projects.title} description={seo.projects.description}>
  <PageHero
    eyebrow="Our projects"
    title="Documented work."
    lead="Renovation and painting work by BNZ Builders Inc. in New York. Each listing shows its verification status. Photos appear only after owner approval."
  />

  <section class="section">
    <div class="wrap">
      <div class="notice reveal" role="note">
        <strong>About these listings.</strong> Statuses are shown as reported and marked pending until verified. Exact addresses of occupied residences are not published. Placeholder frames mark where approved project photos will go.
      </div>

      <div class="project-list">
        {publicProjects.map((p, idx) => (
          <article id={p.slug} class="project-detail reveal" aria-labelledby={`${p.slug}-h`}>
            <div class="project-detail-media">
              <PhotoSlot src={p.photos[0]?.src} alt={p.photos[0]?.alt} ratio="16 / 10" />
              <div class="project-thumbs">
                {[1, 2, 3].map((n) => <PhotoSlot src={p.photos[n]?.src} alt={p.photos[n]?.alt} ratio="4 / 3" small label="Photo pending approval" />)}
              </div>
            </div>
            <div class="project-detail-body">
              <p class="project-index">Project {String(idx + 1).padStart(2, '0')}</p>
              <StatusBadge project={p} />
              <h2 id={`${p.slug}-h`}>{p.title}</h2>
              <dl class="project-facts">
                {p.agencyApproved && p.agency && <div><dt>Agency / owner</dt><dd>{p.agency}</dd></div>}
                <div><dt>Location</dt><dd>{projectLocation(p)}</dd></div>
                <div><dt>Trade</dt><dd>{p.trade}</dd></div>
              </dl>
              <h3 class="mini-h">Scope</h3>
              <ul class="tick-list">
                {p.scope.map((s) => <li>{s}</li>)}
              </ul>
            </div>
            {p.beforeAfter.length > 0 && (
              <div class="project-detail-ba">
                <div class="ba-intro">
                  <h3 class="mini-h">Before / after</h3>
                  <p>Drag the slider to compare. Approved before-and-after photos will appear here once they are cleared with the owner.</p>
                </div>
                {p.beforeAfter.map((ba, i) => <BeforeAfter id={`${p.slug}-${i}`} before={ba.before} after={ba.after} label={ba.label} />)}
              </div>
            )}
          </article>
        ))}
      </div>

      <div class="more-projects reveal">
        <h2>More projects are being documented.</h2>
        <p>We add work here once photos and details are cleared with the owner. Ask us about relevant experience for your project.</p>
        <a class="btn btn--dark" href={u('/contact/')}>Contact us <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
