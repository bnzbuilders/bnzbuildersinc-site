---
import { u } from '../lib/paths';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import CtaBand from '../components/CtaBand.astro';
import { projects, SHOW_DRAFT_PROJECTS } from '../data/site';
const visible = projects.filter((p) => !p.needsVerification || SHOW_DRAFT_PROJECTS);
---
<Base
  title="Projects | BNZ Builders Inc."
  description="Interior build-outs and renovations by the BNZ Builders team in New York. Project photos coming soon."
>
  <PageHero eyebrow="Projects" title="Work and team experience." lead="Interior build-outs and renovations by the BNZ team. Photos are being added as projects are documented." />

  <section class="section">
    <div class="wrap">
      {visible.length > 0 ? (
        <div class="grid grid--3 projects">
          {visible.map((p) => (
            <article class="project">
              <PhotoSlot src={p.photo} alt={p.photoAlt} />
              <div class="project-body">
                {p.needsVerification && <p class="badge">DRAFT, pending approval</p>}
                <p class="project-meta">{p.type} · {p.location} · {p.year}</p>
                <h2>{p.client}</h2>
                <p class="project-title">{p.title}</p>
                <p class="muted project-scope">{p.scope}</p>
                <p class="project-credit">{p.credit}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty">
          <h2>Project gallery coming soon.</h2>
          <p class="lead">We are documenting completed work with photos and owner approval before it goes up here. Ask us about relevant experience.</p>
          <a class="btn btn--dark" href={u('/contact/')}>Contact us</a>
        </div>
      )}
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .project { background: var(--white); border: 1px solid var(--line); display: flex; flex-direction: column; }
  .project-body { padding: 24px 24px 28px; display: flex; flex-direction: column; flex: 1; }
  .project .badge { align-self: flex-start; margin-bottom: 16px; }
  .project-meta { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--orange-text); margin-bottom: 10px; }
  .project h2 { font-size: clamp(1.8rem, 3vw, 2.2rem); margin-bottom: 4px; }
  .project-title { font-weight: 650; margin-bottom: 12px; }
  .project-credit { margin: auto 0 0; padding-top: 14px; border-top: 1px solid var(--line); font-size: 0.9rem; color: var(--ink-2); }
  .project-scope { margin-bottom: 20px; }
  .empty { max-width: 40em; }
</style>
