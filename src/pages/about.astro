---
import { u } from '../lib/paths';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { seo, about, leadership, deliveryApproach, serviceArea } from '../data/site';
const initials = (n: string) => n.split(' ').filter(Boolean).map((w) => w[0]).slice(0, 2).join('');
---
<Base title={seo.about.title} description={seo.about.description} localBusinessSchema>
  <PageHero eyebrow="About us" title="A New York contractor that finishes the job." lead="Commercial renovations, institutional construction, interior improvements and professional painting from Cedarhurst, New York." />

  <section class="section" aria-labelledby="bg-h">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">Background</p>
        <h2 id="bg-h">Who we are.</h2>
      </div>
      <div class="prose prose--lead reveal">
        {about.story.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="lead-h">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Leadership</p>
        <h2 id="lead-h">The team behind the work.</h2>
      </div>
      <ul class="leaders">
        {leadership.map((m, i) => (
          <li class="leader reveal" style={`--i:${i}`}>
            {m.photo
              ? <img class="leader-photo" src={u(m.photo)} alt={`${m.name}, ${m.role}`} loading="lazy" />
              : <span class="leader-mono" aria-hidden="true">{initials(m.name)}</span>}
            <div>
              <h3>{m.name}</h3>
              <p>{m.role}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="capab-h">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">Capabilities</p>
        <h2 id="capab-h">What we deliver.</h2>
        <p class="lead">{serviceArea.note}</p>
        <a class="btn btn--dark" href={u('/services/')}>Our services <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ul class="tick-list tick-list--big reveal">
        {about.capabilities.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="appr-h">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow eyebrow--light">Delivery approach</p>
        <h2 id="appr-h">How a BNZ project runs.</h2>
      </div>
      <ol class="steps steps--dark">
        {deliveryApproach.map((s, i) => (
          <li class="step reveal" style={`--i:${i}`}>
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>
