---
import { u } from '../lib/paths';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { seo, contact, business, officeLine, FORM_ENDPOINT, FORM_HIDDEN_FIELDS } from '../data/site';
// No endpoint → the no-JS fallback posts to mailto: (text/plain). With JS, a
// pre-filled mailto link is built instead (or the endpoint is used).
const action = FORM_ENDPOINT || `mailto:${business.email}?subject=${encodeURIComponent('Quote request — website')}`;
---
<Base title={seo.contact.title} description={seo.contact.description} localBusinessSchema>
  <PageHero eyebrow="Contact us" title={contact.heading} lead={contact.lead} />

  <section class="section">
    <div class="wrap contact-grid">
      <aside class="contact-card" aria-labelledby="direct-h">
        <h2 id="direct-h">Reach us directly.</h2>
        <dl>
          <dt>Phone</dt><dd><a href={business.phoneHref}>{business.phoneDisplay}</a></dd>
          <dt>Email</dt><dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
          <dt>Office</dt><dd><address>{business.legalName}<br />{officeLine}</address></dd>
          <dt>Service area</dt><dd>New York State · priority NYC &amp; Long Island</dd>
        </dl>
        <p class="contact-note">Public agency or GC with a bid invitation? Email the package or plan-room link. See <a href={u('/government-contracting/')}>government contracting</a>.</p>
      </aside>

      <form
        class="form"
        id="quote-form"
        action={action}
        method="post"
        enctype={FORM_ENDPOINT ? undefined : 'text/plain'}
        data-endpoint={FORM_ENDPOINT}
        data-email={business.email}
        novalidate
        aria-labelledby="form-h"
      >
        <h2 id="form-h" class="form-title">Project details</h2>
        <p class="form-required"><span class="req" aria-hidden="true">*</span> Required</p>
        {Object.entries(FORM_HIDDEN_FIELDS).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
        <div class="form-row">
          <div class="field">
            <label for="f-name">Name <span class="req" aria-hidden="true">*</span></label>
            <input id="f-name" name="name" autocomplete="name" required aria-describedby="e-name" />
            <p class="field-error" id="e-name"></p>
          </div>
          <div class="field">
            <label for="f-company">Company <span class="opt">(optional)</span></label>
            <input id="f-company" name="company" autocomplete="organization" />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="f-email">Email <span class="req" aria-hidden="true">*</span></label>
            <input id="f-email" name="email" type="email" autocomplete="email" required aria-describedby="e-email" />
            <p class="field-error" id="e-email"></p>
          </div>
          <div class="field">
            <label for="f-phone">Phone <span class="req" aria-hidden="true">*</span></label>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" required pattern="[0-9()+.\- ]{7,}" aria-describedby="e-phone" />
            <p class="field-error" id="e-phone"></p>
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="f-type">Project type <span class="req" aria-hidden="true">*</span></label>
            <select id="f-type" name="project_type" required aria-describedby="e-type">
              <option value="">Select a service…</option>
              {contact.projectTypes.map((t) => <option>{t}</option>)}
            </select>
            <p class="field-error" id="e-type"></p>
          </div>
          <div class="field">
            <label for="f-location">Project location <span class="req" aria-hidden="true">*</span></label>
            <input id="f-location" name="location" placeholder="Town or neighborhood, NY" required aria-describedby="e-location" />
            <p class="field-error" id="e-location"></p>
          </div>
        </div>
        <div class="field">
          <label for="f-timeline">Timeline <span class="opt">(optional)</span></label>
          <select id="f-timeline" name="timeline">
            <option value="">Select…</option>
            {contact.timelines.map((t) => <option>{t}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-message">Message <span class="req" aria-hidden="true">*</span></label>
          <textarea id="f-message" name="message" required minlength="10" rows="6" placeholder="Scope, size, building type, occupied or vacant, drawings available…" aria-describedby="e-message"></textarea>
          <p class="field-error" id="e-message"></p>
        </div>
        <div class="hp" aria-hidden="true"><label for="f-website">Leave this field empty</label><input id="f-website" name="website" tabindex="-1" autocomplete="off" /></div>
        <div class="form-actions">
          <button class="btn btn--primary btn--lg" type="submit">Send request <span class="arrow" aria-hidden="true">→</span></button>
          <p class="form-note">
            {FORM_ENDPOINT
              ? 'We use your details only to respond to this request.'
              : `Sending opens your email app with this request filled in, addressed to ${business.email}.`}
            {' '}<a href={u('/privacy/')}>Privacy</a>.
          </p>
        </div>
        <div class="form-status" role="status" aria-live="polite" tabindex="-1"></div>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const endpoint = form.dataset.endpoint || '';
    const email = form.dataset.email || '';
    const show = (html: string, kind = 'ok') => {
      status.innerHTML = html;
      status.dataset.kind = kind;
      status.classList.add('is-visible');
      status.focus();
    };
    const labels: Record<string, string> = {
      name: 'Name', company: 'Company', email: 'Email', phone: 'Phone', project_type: 'Project type',
      location: 'Location', timeline: 'Timeline', message: 'Message',
    };
    const messageFor = (el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      const v = el.validity;
      const name = labels[el.name] || 'This field';
      if (v.valueMissing) return el.tagName === 'SELECT' ? `Please choose a ${name.toLowerCase()}.` : `Please enter your ${name.toLowerCase()}.`;
      if (v.typeMismatch && el.type === 'email') return 'Please enter a valid email address, like name@company.com.';
      if (v.patternMismatch) return 'Please enter a valid phone number.';
      if (v.tooShort) return `Please add a little more detail (at least ${(el as HTMLTextAreaElement).minLength} characters).`;
      return '';
    };
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]'));
    const check = (el: (typeof fields)[number]) => {
      const msg = el.checkValidity() ? '' : messageFor(el);
      const err = document.getElementById(el.getAttribute('aria-describedby') || '');
      if (err) err.textContent = msg;
      el.toggleAttribute('aria-invalid', !!msg);
      if (msg) el.setAttribute('aria-invalid', 'true');
      return !msg;
    };
    fields.forEach((el) => {
      el.addEventListener('blur', () => { if (el.value) check(el); });
      el.addEventListener('input', () => { if (el.hasAttribute('aria-invalid')) check(el); });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = fields.filter((el) => !check(el));
      if (invalid.length) {
        invalid[0].focus();
        show(`Please fix ${invalid.length === 1 ? 'the highlighted field' : `the ${invalid.length} highlighted fields`} and send again.`, 'error');
        invalid[0].focus();
        return;
      }
      const data = new FormData(form);
      if (data.get('website')) return; // honeypot filled → bot
      data.delete('website');

      if (endpoint) {
        try {
          const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          show('<strong>Request received.</strong> Thank you. We will be in touch soon.');
          return;
        } catch {
          // fall through to mailto so no request is lost
        }
      }
      const lines = Object.keys(labels).map((k) => `${labels[k]}: ${(data.get(k) || '').toString().trim() || '—'}`);
      const subject = `Quote request — ${(data.get('project_type') || 'Project').toString()} — ${(data.get('location') || '').toString()}`;
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
      show(`<strong>Almost done.</strong> Your email app should open with this request filled in. Press send there to reach us. If nothing opened, email <a href="mailto:${email}">${email}</a> or call 1-332-258-1401.`);
    });
  }
</script>
