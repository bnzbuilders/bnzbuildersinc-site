---
import { u } from '../lib/paths';
import Base from '../layouts/Base.astro';
import { business } from '../data/site';
---
<Base title="Page not found | BNZ Builders Inc." description="This page does not exist." noindex>
  <section class="section nf">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1>Not on the plans.</h1>
      <p class="lead">The page you are looking for does not exist or has moved.</p>
      <div class="btn-row" style="margin-top:28px">
        <a class="btn btn--primary" href={u('/')}>Back to home</a>
        <a class="btn btn--ghost" href={u('/contact/')}>Request a Quote</a>
        <a class="btn btn--ghost" href={business.phoneHref}>Call {business.phoneDisplay}</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 60vh; display: flex; align-items: center; }
  .nf h1 { font-size: clamp(3.5rem, 12vw, 8rem); }
</style>
