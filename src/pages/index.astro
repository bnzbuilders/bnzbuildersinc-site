---
import { u } from '../lib/paths';
import Base from '../layouts/Base.astro';
import PlanDrawing from '../components/PlanDrawing.astro';
import CtaBand from '../components/CtaBand.astro';
import CredList from '../components/CredList.astro';
import { business, home, services, differentiators, publicWorks, credentials, serviceArea } from '../data/site';
const ids = credentials.filter((c) => ['D-U-N-S', 'NYC DCWP', 'NYSDOL public work registration'].includes(c.label));
---
<Base title={home.seoTitle} description={home.seoDescription} localBusinessSchema>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{business.credentialLine}</p>
        <h1>Built right.<br />On time.<br /><span class="hl">On budget.</span></h1>
        <p class="lead">{home.heroLead}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={u('/contact/')}>Request a Quote <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href={u('/public-works/')}>Public agency? View credentials</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="false">
        <PlanDrawing />
      </div>
    </div>
    <div class="wrap">
      <dl class="facts">
        {home.facts.map((f) => (
          <div class="fact"><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">What we do</p>
          <h2 id="svc-h">{home.servicesHeading}</h2>
        </div>
        <a class="text-link" href={u('/services/')}>All services &amp; scopes</a>
      </div>
      <ol class="svc-list svc-list--cols">
        {services.map((s, i) => (
          <li class="svc-item">
            <span class="svc-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.short}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="why-h">
    <div class="wrap">
      <div class="split">
        <div>
          <p class="eyebrow">How we work</p>
          <h2 id="why-h">{business.aboutLine}</h2>
          <p class="lead">One project manager, start to finish. Protection for buildings that stay in use. Paperwork done right on public work.</p>
          <a class="btn btn--ghost" href={u('/about/')} style="margin-top:12px">About BNZ</a>
        </div>
        <div class="grid grid--2">
          {differentiators.map((d) => (
            <div class="card--line card">
              <h3>{d.title}</h3>
              <p>{d.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pw-h">
    <div class="wrap split split--even">
      <div>
        <p class="eyebrow">Public works</p>
        <h2 id="pw-h">{publicWorks.heading}</h2>
        <p class="lead">{publicWorks.lead}</p>
        <ul class="check-list" style="margin:28px 0 32px">
          {publicWorks.capabilities.map((c) => <li><strong>{c.title}.</strong> <span class="muted">{c.text}</span></li>)}
        </ul>
        <div class="btn-row">
          <a class="btn btn--dark" href={u('/public-works/')}>Credentials</a>
          <a class="btn btn--ghost" href={u('/capability-statement/')}>Capability statement</a>
        </div>
      </div>
      <div class="cred-card">
        <p class="dim">Facts on file</p>
        <CredList label="Registrations" rows={[...ids, { label: 'Bonding', value: 'Available based on project requirements' }]} />
      </div>
    </div>
  </section>

  <section class="section section--paper2" aria-labelledby="area-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Service area</p>
        <h2 id="area-h">{serviceArea.heading}</h2>
      </div>
      <ul class="area-list">
        {serviceArea.areas.map((a) => <li>{a}</li>)}
      </ul>
      <p class="muted" style="margin-top:28px;max-width:44em">{serviceArea.note} Based in {business.address.city}, {business.address.region}.</p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { padding: clamp(40px, 7vw, 96px) 0 0; position: relative; }
  .hero-grid { display: grid; gap: 40px; align-items: center; padding-bottom: clamp(40px, 6vw, 72px); }
  .hero h1 { font-size: clamp(3.6rem, 13vw, 8.5rem); line-height: 0.88; margin-bottom: 28px; }
  .hero .hl { color: var(--orange); }
  .hero .lead { margin-bottom: 32px; }
  .hero-art { background: var(--black); padding: clamp(18px, 3vw, 32px); position: relative; }
  .hero-art::before { content: ''; position: absolute; top: -10px; left: -10px; width: 64px; height: 64px; border-top: 4px solid var(--orange); border-left: 4px solid var(--orange); }
  @media (min-width: 1000px) {
    .hero-grid { grid-template-columns: 7fr 5fr; gap: 64px; }
  }
  .cred-card { background: var(--white); border: 1px solid var(--line); padding: clamp(24px, 4vw, 44px); border-top: 4px solid var(--orange); }
  .cred-card .dim { margin-bottom: 10px; }
  .area-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; border-top: 2px solid var(--ink); }
  .area-list li { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: clamp(1.8rem, 4.5vw, 3rem); line-height: 1; padding: 18px 0; border-bottom: 1px solid var(--line-strong); display: flex; justify-content: space-between; align-items: center; }
  .area-list li::after { content: 'NY'; font-family: var(--font-body); font-size: 0.75rem; font-weight: 700; letter-spacing: .14em; color: var(--orange-text); }
  @media (min-width: 720px) { .area-list { grid-template-columns: 1fr 1fr; column-gap: 48px; } }
  @media (min-width: 1000px) { .area-list { grid-template-columns: repeat(3, 1fr); } }
</style>
