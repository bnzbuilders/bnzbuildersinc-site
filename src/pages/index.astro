---
import { u } from '../lib/paths';
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import ServiceIcon from '../components/ServiceIcon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { business, seo, services, publicProjects, agenciesPursued, deliveryApproach, HERO_PHOTO, HERO_PHOTO_ALT } from '../data/site';
import { heroStock, serviceStock, STOCK_NOTE } from '../data/stock';
const [core, ...rest] = services;
const featured = publicProjects.filter((p) => p.featured);
---
<Base title={seo.home.title} description={seo.home.description} localBusinessSchema>
  <section class="hero" aria-labelledby="hero-h">
    <div class:list={['hero-bg', { 'hero-bg--stock': !HERO_PHOTO }]}>
      {HERO_PHOTO
        ? <img class="hero-photo" src={u(HERO_PHOTO)} alt={HERO_PHOTO_ALT} fetchpriority="high" />
        : <>
            <Picture class="hero-photo" src={heroStock.src} alt={heroStock.alt} formats={['avif', 'webp']} widths={[640, 960, 1280, 1600, 2000]} sizes="(min-width: 1080px) 54vw, 100vw" loading="eager" fetchpriority="high" decoding="async" style={heroStock.position ? `object-position:${heroStock.position}` : undefined} />
            <span class="stock-note stock-note--hero">Representative image</span>
          </>}
    </div>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow eyebrow--light hero-anim" style="--d:0">BNZ Builders Inc.</p>
        <p class="hero-line hero-anim" style="--d:1">Commercial Construction. Renovations. Public Works.</p>
        <h1 id="hero-h" class="hero-anim" style="--d:2">Building with precision. <span>Delivering with purpose.</span></h1>
        <p class="lead hero-anim" style="--d:3">{business.summary}</p>
        <div class="btn-row hero-anim" style="--d:4">
          <a class="btn btn--primary btn--lg" href={u('/contact/')}>Request a Quote <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost btn--lg" href={u('/projects/')}>View Our Projects</a>
        </div>
      </div>
    </div>
    <div class="wrap">
      <dl class="hero-facts">
        <div><dt>Headquarters</dt><dd>Cedarhurst, NY</dd></div>
        <div><dt>Priority markets</dt><dd>NYC &amp; Long Island</dd></div>
        <div><dt>Public works</dt><dd>Across New York State</dd></div>
        <div><dt>Core trade</dt><dd>Professional painting</dd></div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="section-head section-head--row reveal">
        <div>
          <p class="eyebrow">What we do</p>
          <h2 id="svc-h">Renovation and finish work, delivered under one contract.</h2>
        </div>
        <a class="text-link" href={u('/services/')}>All services <span aria-hidden="true">→</span></a>
      </div>

      <a class:list={['svc-feature reveal', { 'svc-feature--photo': serviceStock[core.slug] }]} href={u(`/services/#${core.slug}`)}>
        {serviceStock[core.slug] && (
          <div class="svc-media svc-media--feature">
            <Picture src={serviceStock[core.slug].src} alt={serviceStock[core.slug].alt} formats={['avif', 'webp']} widths={[400, 640, 960]} sizes="(min-width: 1020px) 380px, (min-width: 640px) 90vw, 100vw" loading="lazy" decoding="async" style={serviceStock[core.slug].position ? `object-position:${serviceStock[core.slug].position}` : undefined} />
          </div>
        )}
        <div class="svc-feature-main">
          <span class="tag">Core trade</span>
          <ServiceIcon name={core.icon} size={40} />
          <h3>{core.title}</h3>
          <p>{core.intro}</p>
          <span class="text-link text-link--light">Painting services <span aria-hidden="true">→</span></span>
        </div>
        <ul class="svc-feature-list">
          {core.items.map((i) => <li>{i}</li>)}
        </ul>
      </a>

      <div class="svc-grid">
        {rest.map((s, i) => (
          <a class:list={['svc-card reveal', { 'svc-card--photo': serviceStock[s.slug] }]} href={u(`/services/#${s.slug}`)} style={`--i:${i}`}>
            {serviceStock[s.slug] && (
              <div class="svc-media">
                <Picture src={serviceStock[s.slug].src} alt={serviceStock[s.slug].alt} formats={['avif', 'webp']} widths={[400, 640, 960]} sizes="(min-width: 1020px) 400px, (min-width: 640px) 50vw, 100vw" loading="lazy" decoding="async" style={serviceStock[s.slug].position ? `object-position:${serviceStock[s.slug].position}` : undefined} />
              </div>
            )}
            <span class="svc-num">{String(i + 2).padStart(2, '0')}</span>
            <ServiceIcon name={s.icon} />
            <h3>{s.title}</h3>
            <p>{s.short}</p>
            <span class="svc-more" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <p class="fine stock-fine">{STOCK_NOTE}: general stock photos of the trades, not BNZ projects.</p>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="proj-h">
    <div class="wrap">
      <div class="section-head section-head--row reveal">
        <div>
          <p class="eyebrow">Documented work</p>
          <h2 id="proj-h">Featured projects.</h2>
          <p class="section-sub">Institutional renovation and painting work in New York. Statuses are shown as pending until verified; approved photos are added as they are cleared.</p>
        </div>
        <a class="text-link" href={u('/projects/')}>View our projects <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid grid--2">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <section class="gov-strip" aria-labelledby="gov-h">
    <div class="wrap gov-strip-inner">
      <div class="reveal">
        <p class="eyebrow eyebrow--light">Government contracting</p>
        <h2 id="gov-h">Public works and institutional construction across New York State.</h2>
        <p class="lead">Renovations for agencies, authorities and institutional owners, run with the documentation, prevailing-wage awareness and occupied-building care that public work demands.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={u('/government-contracting/')}>Government contracting <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="gov-pursue reveal">
        <p class="gov-pursue-h">Agencies and owners we pursue work with</p>
        <ul class="agency-chips">
          {agenciesPursued.map((a) => <li title={a.name}>{a.short}</li>)}
        </ul>
        <p class="fine">Listing an agency here does not indicate a current contract or prequalification. See <a href={u('/government-contracting/#documented')}>documented work</a>.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-h">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">How we work</p>
        <h2 id="how-h">One point of contact, scope to closeout.</h2>
      </div>
      <ol class="steps">
        {deliveryApproach.map((s, i) => (
          <li class="step reveal" style={`--i:${i}`}>
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>
